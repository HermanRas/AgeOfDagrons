# ─────────────────────────────────────────────────────────────
# Reference material — not part of the build
# ─────────────────────────────────────────────────────────────
# Trailing /* (not just /) so git still descends far enough to honour the
# .gdignore exception below -- a bare "assets/insperation_pictures/" excludes the
# directory itself, and git never looks inside an excluded directory to
# check per-file negations (a well-known gitignore gotcha).
assets/insperation_pictures/*
!assets/insperation_pictures/.gdignore

# ─────────────────────────────────────────────────────────────
# Third-party asset packs — DO NOT COMMIT
# The itch.io UI packs allow personal + commercial use but
# explicitly forbid redistribution of the original files.
# Committing them to a public repo would be redistribution.
# Each developer downloads them via the .url links below.
# Using the art inside a built game (APK/.pck) is fine.
# ─────────────────────────────────────────────────────────────
assets/UI_Sprites/*.zip
assets/UI_Sprites/UI_dragon-huds/
assets/UI_Sprites/Free_Medieval_Fantasy_UI_Pack/
assets/UI_Sprites/uı-fonts/
assets/UI_Sprites/ui-fonts/
!assets/UI_Sprites/*.url
!assets/UI_Sprites/README.md

# HUD icon source sheets (game/assets/LICENCES.md) -- the project owner's own
# Gemini-generated working sheets, kept locally so the 5x5 sheet's remaining
# empty slots can be filled from the same artwork, but not needed in the repo.
assets/Icons/

# Loose Gemini working-source drops at the assets/ root (e.g. MainMenu.png,
# Age_and_Upgrade_bar.png) -- same convention as assets/Icons/ above: the cut
# asset actually used ships from game/assets/ui/, the raw source stays local.
# Not recursive, so a real subfolder (UI_Sprites/, Icons/) is unaffected.
assets/*.png
assets/*.jpg

# Raw art source (0 A.D. checkout, Blender working files).
# Lives outside the repo entirely — see PLAN.md §1.3
art_source/
art_work/

# ─────────────────────────────────────────────────────────────
# Godot
# ─────────────────────────────────────────────────────────────
.godot/
game/.godot/
game/android/build/
game/.mono/
*.translation

# Export artifacts
export/
build/
*.apk
*.aab
*.pck
*.idsig          # adb incremental-install signature, regenerated per install
*.apk.idsig
*.zip.md5
*.exp
*.lib

# Godot editor per-user state
*.import.bak

# ─────────────────────────────────────────────────────────────
# Built asset packs — hosted on the website, not in git
# ─────────────────────────────────────────────────────────────
packs/
game/assets/atlases/

# Kibyra UI pack art copied locally from assets/UI_Sprites/ for use in the
# built game (permitted) but not for redistribution of the originals via git
# (not permitted -- see game/assets/LICENCES.md). Each developer re-copies
# from their own assets/UI_Sprites/ download; see the source path noted where
# it is used.
game/assets/ui/control_groups/
game/assets/ui/menu/
game/assets/ui/hud/

# ─────────────────────────────────────────────────────────────
# Python tooling
# ─────────────────────────────────────────────────────────────
tools_env/

# Per-machine isobake paths (Blender, 0 A.D. checkout, output dir).
# PLAN.md §2.6: raw-art paths are never committed. The committed camera config
# is tools/isobake.toml; see tools/isobake.local.toml.example.
tools/isobake.local.toml
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ─────────────────────────────────────────────────────────────
# Blender
# ─────────────────────────────────────────────────────────────
*.blend1
*.blend2
*.blend3

# ─────────────────────────────────────────────────────────────
# OS / cloud-sync noise
# ─────────────────────────────────────────────────────────────
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
.tmp.drivedownload/
.tmp.drive-*
*.tmp

# ─────────────────────────────────────────────────────────────
# Editors
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.claude/settings.json
